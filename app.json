{
  "expo": {
    "name": "Team Masda Evolution",
    "slug": "team-masda-evolution",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fondoAndroid.jpeg",
    "scheme": "teammasdaevolution",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/fondoAndroid.jpeg",
        "backgroundImage": "./assets/images/fondoAndroid.jpeg",
        "monochromeImage": "./assets/images/fondoAndroid.jpeg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anerto.teammasdaevolution"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fondoAndroid.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fondoAndroid.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a $(PRODUCT_NAME) usar la cámara para escanear códigos QR."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f561d161-2a29-4ddb-9587-4cee4ab244ab"
      }
    }
  }
}
